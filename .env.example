# =========================================================
# EigenMinds - AI Agent Commerce & MST Blockchain Settlement
# Environment Variable Blueprint
# NEVER COMMIT REAL KEYS OR SECRETS TO REPOSITORY
# =========================================================

# ---------------------------------------------------------
# Server (Backend) Configuration
# ---------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/eigenminds

# AI Provider API Keys (Modular LLM layer)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Backend Relay/Oracle Signer Wallet (OPTIONAL for automatic escrow verification)
# MUST BE A DEDICATED TESTNET SIGNER KEY ONLY - NEVER PERSONAL HUMAN WALLET KEY
MST_RELAY_PRIVATE_KEY=your_testnet_relay_private_key_here

# ---------------------------------------------------------
# Frontend (Client) Configuration (Exposed to Vite)
# ---------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_MST_NETWORK_NAME=MST Testnet
VITE_MST_RPC_URL=https://testnetrpc.mstblockchain.com
VITE_MST_CHAIN_ID=91562037
VITE_MST_ESCROW_CONTRACT_ADDRESS=your_deployed_contract_address_here
VITE_MST_FAUCET_URL=https://faucet.masterstroke.academy
VITE_MST_EXPLORER_URL=https://testnet.mstscan.com

# ---------------------------------------------------------
# Smart Contracts (Hardhat Workspace)
# ---------------------------------------------------------
MST_TESTNET_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
MST_DEPLOYER_PRIVATE_KEY=your_testnet_deployer_private_key_here
